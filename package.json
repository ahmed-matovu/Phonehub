{
  "name": "phonehub",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace @phonehub/backend\" \"npm run dev --workspace @phonehub/frontend\"",
    "build": "npm run build --workspace @phonehub/backend && npm run build --workspace @phonehub/frontend",
    "start": "concurrently \"npm run start --workspace @phonehub/backend\" \"npm run start --workspace @phonehub/frontend\""
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
